{
  "name": "tracegate-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false && tsc -p tsconfig.check.json",
    "test": "pnpm build && vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "experiments": "tsx experiments/run-all.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
